#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

// Culls every node against a range of views in one dispatch: x covers nodes,
// y the views from params.first_view. A visible node is appended to list
// key * view.list_stride of the bindless draw lists view.draw_list, key its
// material type or, for a custom material, CUSTOM + its shader - 1; list l
// keeps its count at counts[l] and its commands from l * view.list_capacity.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;


// MaterialType.CUSTOM, and the custom shaders the draw list header has room for
// (render.MAX_MATERIAL_SHADERS)
const uint MATERIAL_CUSTOM = 5u;
const uint MAX_MATERIAL_SHADERS = 3u;

struct NodeData {
    mat4 world_matrix;
    uint material_id;
    uint mesh_id;
    uint attachment_data_index;
    uint flags;
    uint skin_vertex_base; // first of the skinned vertices when skinned
    uint _node_pad[3];
};

struct MeshData {
    vec3 aabb_min;
    uint index_count;
    vec3 aabb_max;
    uint first_index;
    int vertex_offset;
    uint vertex_skinning_offset;
    uint flags;
    uint _padding;
};

struct MaterialData {
    uint albedo_index;
    uint metallic_roughness_index;
    uint normal_index;
    uint emissive_index;
    float metallic_value;
    float roughness_value;
    float emissive_value;
    uint shader; // CUSTOM: the user shader, from 1
    vec4 base_color_factor;
    uint frame_columns;
    uint frame_rows;
    uint frame_index;
    uint type; // MaterialType
};

struct View {
    mat4 view;
    mat4 projection;
    mat4 view_projection;
    mat4 inv_view_projection; // rebuilds world positions from depth
    vec4 planes[6]; // normalized, pointing inward
    vec4 position;
    vec2 extent;
    float near;
    float far;
    uint attachments[6]; // this frame's bindless images, by AttachmentType
    uint pyramid; // bindless depth pyramid
    uint occlusion_mask; // bit t: material type t is tested against the pyramid
    uint list_stride;
    uint type_mask; // bit t: material type t is drawn
    uint require_flags; // node flags a drawn node has
    uint instance_tag; // OR-ed into first_instance above the node index
    uint layer;
    uint draw_list; // bindless draw lists the view appends to
    uint list_capacity; // draws per list
    uint _pad0;
};

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(push_constant) uniform PushConstants {
    uint node_count;
    uint first_view;
} params;

const float DEPTH_BIAS = 0.0001;

layout(set = 0, binding = 1) readonly buffer NodeBuffer {
    NodeData nodes[];
};

layout(set = 0, binding = 2) readonly buffer MeshBuffer {
    MeshData meshes[];
};

layout(set = 0, binding = 3) readonly buffer MaterialBuffer {
    MaterialData materials[];
};

layout(set = 0, binding = 0) readonly buffer ViewBuffer {
    View views[];
};

layout(set = 1, binding = 0) uniform texture2D textures[];
layout(set = 1, binding = 1) uniform sampler samplers[];

const uint DRAW_LIST_HEADER = 8u;

layout(set = 1, binding = 3) buffer DrawLists {
    uint counts[DRAW_LIST_HEADER];
    DrawCommand commands[];
} draw_lists[];

bool in_view(View view, vec3 center, vec3 extent) {
    for (int i = 0; i < 6; ++i) {
        vec4 plane = view.planes[i];
        float distance = dot(plane.xyz, center) + plane.w;
        float radius = dot(abs(plane.xyz), extent);
        if (distance + radius < 0.0) {
            return false;
        }
    }
    return true;
}

// 2D Polyhedral Bounds of a Clipped, Perspective-Projected 3D Sphere
bool project_sphere(vec3 center, float radius, mat4 proj, float near, float far, out vec4 aabb) {
    if (center.z - radius > -near) return false;
    if (center.z + radius < -far) return false;

    vec3 c = vec3(center.x, center.y, -center.z);
    float r = radius;
    float znear = near;

    if (c.z < r + znear) {
        return false;
    }

    float P00 = proj[0][0];
    float P11 = abs(proj[1][1]);

    vec3 cr = c * r;
    float czr2 = c.z * c.z - r * r;

    float vx = sqrt(c.x * c.x + czr2);
    float minx = (vx * c.x - cr.z) / (vx * c.z + cr.x);
    float maxx = (vx * c.x + cr.z) / (vx * c.z - cr.x);

    float vy = sqrt(c.y * c.y + czr2);
    float miny = (vy * c.y - cr.z) / (vy * c.z + cr.y);
    float maxy = (vy * c.y + cr.z) / (vy * c.z - cr.y);

    aabb = vec4(minx * P00, miny * P11, maxx * P00, maxy * P11);
    aabb = aabb.xwzy * vec4(0.5, -0.5, 0.5, -0.5) + vec4(0.5);
    aabb = clamp(aabb, 0.0, 1.0);

    return (aabb.z > aabb.x) && (aabb.w > aabb.y);
}

// return true if the sphere is visible, false if occluded
// Farthest depth of the 2x2 texels of mip `level` around uv, like a bilinear
// fetch reduced with MAX.
float max_depth(uint pyramid, vec2 uv, int level) {
    ivec2 size = textureSize(textures[pyramid], level);
    ivec2 i0 = ivec2(floor(uv * vec2(size) - 0.5));
    ivec2 lo = clamp(i0, ivec2(0), size - 1);
    ivec2 hi = clamp(i0 + 1, ivec2(0), size - 1);
    return max(max(texelFetch(textures[pyramid], lo, level).r, texelFetch(textures[pyramid], ivec2(hi.x, lo.y), level).r),
               max(texelFetch(textures[pyramid], ivec2(lo.x, hi.y), level).r, texelFetch(textures[pyramid], hi, level).r));
}

bool occlusion_test(vec3 center, float radius, View view) {
    vec4 view_center4 = view.view * vec4(center, 1.0);
    vec3 view_center = view_center4.xyz;

    vec4 aabb;
    if (!project_sphere(view_center, radius, view.projection, view.near, view.far, aabb)) {
        return true;
    }

    vec2 pyramid_size = vec2(textureSize(textures[view.pyramid], 0));
    float width = (aabb.z - aabb.x) * pyramid_size.x;
    float height = (aabb.w - aabb.y) * pyramid_size.y;
    float level = ceil(log2(max(width, height)));
    level = clamp(level, 0.0, float(textureQueryLevels(textures[view.pyramid]) - 1));

    vec2 sample_uv = (aabb.xy + aabb.zw) * 0.5;
    float occluder_depth = max_depth(view.pyramid, sample_uv, int(level));

    float object_near_z = view_center.z + radius;
    vec4 clip_pos = view.projection * vec4(0, 0, object_near_z, 1.0);
    float object_depth = clip_pos.z / clip_pos.w;

    return object_depth < (occluder_depth + DEPTH_BIAS);
}

void main() {
    uint node_id = gl_GlobalInvocationID.x;
    if (node_id >= params.node_count) return;
    View view = views[params.first_view + gl_WorkGroupID.y];
    // empty view (free camera slot): accepts nothing
    if (view.type_mask == 0u) return;

    NodeData node = nodes[node_id];
    // 0 is none
    if (node.mesh_id == 0u || node.material_id == 0u) return;
    if ((node.flags & view.require_flags) != view.require_flags) return;
    MaterialData material = materials[node.material_id];
    uint type = material.type;
    if (((view.type_mask >> type) & 1u) == 0u) return;
    // a custom material without a valid shader draws nowhere
    if (type == MATERIAL_CUSTOM && (material.shader == 0u || material.shader > MAX_MATERIAL_SHADERS)) return;

    MeshData mesh = meshes[node.mesh_id];
    mat4 world = node.world_matrix;
    vec3 local_center = 0.5 * (mesh.aabb_min + mesh.aabb_max);
    vec3 local_extent = 0.5 * (mesh.aabb_max - mesh.aabb_min);
    vec4 world_center4 = world * vec4(local_center, 1.0);
    vec3 world_center = world_center4.xyz / max(world_center4.w, 1e-6);
    mat3 world3 = mat3(world);
    mat3 abs_world3 = mat3(abs(world3[0]), abs(world3[1]), abs(world3[2]));
    vec3 world_extent = abs_world3 * local_extent;

    if (!in_view(view, world_center, world_extent)) return;
    if (((view.occlusion_mask >> type) & 1u) != 0u &&
        !occlusion_test(world_center, length(world_extent), view)) {
        return;
    }

    DrawCommand cmd;
    cmd.index_count = mesh.index_count;
    cmd.instance_count = 1u;
    cmd.first_index = mesh.first_index;
    cmd.vertex_offset = mesh.vertex_offset;
    cmd.first_instance = node_id | view.instance_tag;

    uint key = type == MATERIAL_CUSTOM ? MATERIAL_CUSTOM + material.shader - 1u : type;
    uint list = key * view.list_stride;
    uint draw_index = atomicAdd(draw_lists[view.draw_list].counts[list], 1u);
    if (draw_index < view.list_capacity) {
        draw_lists[view.draw_list].commands[list * view.list_capacity + draw_index] = cmd;
    }
}
