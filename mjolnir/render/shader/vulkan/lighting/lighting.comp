#version 450
#extension GL_EXT_nonuniform_qualifier : require

// Deferred lighting, tiled: a group shades a TILE x TILE tile of the camera's image. It finds
// the tile's depth range and walks the light placements once, listing the visible placed
// lights that reach the tile: every directional light, the point and spot lights whose sphere
// meets the tile's box. Then each invocation shades its pixel once: image-based ambient and
// emissive, then the listed lights. The background gets the skybox, or black. A placed light
// is a Light at a node's transform (scene.odin light_pose).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const uint TILE = 16u;
const float PI = 3.14159265359;
const uint INVALID_TEXTURE = 0u;
const uint MAX_LIGHTS = 256u;

const uint SAMPLER_NEAREST_CLAMP = 0u;
const uint SAMPLER_LINEAR_CLAMP = 1u;
const uint SAMPLER_NEAREST_REPEAT = 2u;
const uint SAMPLER_LINEAR_REPEAT = 3u;
const uint SAMPLER_SHADOW_COMPARE = 4u;

const uint LIGHT_POINT = 0u;
const uint LIGHT_SPOT = 1u;
const uint LIGHT_DIRECTIONAL = 2u;
// shadowFace past the last cascade
const uint NO_FACE = 0xFFFFFFFFu;

layout(set = 0, binding = 11) uniform texture2DArray shadow_maps;
layout(set = 1, binding = 0) uniform texture2D textures[];
layout(set = 1, binding = 1) uniform sampler samplers[];
layout(set = 1, binding = 0) uniform textureCube cube_textures[]; // aliases textures
layout(set = 1, binding = 2, rgba16f) writeonly uniform image2D lit_images[];

struct Light {
    vec3 color;
    float intensity;
    float radius;
    float angle_inner;
    float angle_outer;
    uint type;
    uint cast_shadow;
};

struct LightPlacement {
    uint light;
    uint node;
    uint shadow_map; // view index of the first shadow face, 0 for none
};

struct Node {
    mat4 world_matrix;
    uint material_id;
    uint mesh_id;
    uint attachment_data_index;
    uint flags;
    uint skin_vertex_base;
    uint _node_pad[3];
};

const uint NODE_VISIBLE = 1u;

// View.images indices (CameraImage)
const uint IMAGE_NORMAL = 1u;
const uint IMAGE_ALBEDO = 2u;
const uint IMAGE_METALLIC_ROUGHNESS = 3u;
const uint IMAGE_EMISSIVE = 4u;
const uint IMAGE_DEPTH = 5u;

struct View {
    mat4 view;
    mat4 projection;
    mat4 view_projection;
    mat4 inv_view_projection; // rebuilds world positions from depth
    vec4 planes[6]; // normalized, pointing inward
    vec4 position;
    vec2 extent;
    float near;
    float far;
    uint images[6]; // this frame's bindless images, by CameraImage
    uint pyramid; // bindless depth pyramid
    uint occlusion_mask; // bit t: material type t is tested against the pyramid
    uint list_stride;
    uint type_mask; // bit t: material type t is drawn
    uint require_flags; // node flags a drawn node has
    uint instance_tag; // OR-ed into first_instance above the node index
    uint layer;
    uint draw_list; // bindless draw lists the view appends to
    uint list_capacity; // draws per list
    float time; // render's clock in seconds
};

layout(set = 0, binding = 0) readonly buffer ViewBuffer {
    View views[];
};

layout(set = 0, binding = 1) readonly buffer NodeBuffer {
    Node nodes[];
};

layout(set = 0, binding = 10) readonly buffer LightBuffer {
    Light lights[];
};

layout(set = 0, binding = 18) readonly buffer LightPlacementBuffer {
    LightPlacement placements[];
};

layout(push_constant) uniform LightingPush {
    uint camera_index;
    uint irradiance_index;
    uint prefilter_index;
    uint brdf_lut_index;
    uint environment_index;
    float skybox_intensity;
    float skybox_blur;
    uint output_index; // storage image the camera's lit image is bound at
    uint light_count; // rows of the placement table
    float ibl_intensity;
    uint _pad0;
    uint _pad1;
};

shared uint tile_min_bits;
shared uint tile_max_bits;
shared uint tile_light_count;
shared uint tile_lights[MAX_LIGHTS];

// World position of the G-buffer texel at framebuffer uv, rebuilt from its
// depth. Clip-space y points down, so ndc follows uv on both axes.
vec3 worldPosition(View camera, vec2 uv, float depth) {
    vec4 p = camera.inv_view_projection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return p.xyz / p.w;
}

float sceneDepth(View camera, ivec2 pixel) {
    return texelFetch(sampler2D(textures[camera.images[IMAGE_DEPTH]], samplers[SAMPLER_NEAREST_CLAMP]), pixel, 0).r;
}

vec4 camera_image(View camera, uint a, ivec2 pixel) {
    return texelFetch(sampler2D(textures[camera.images[a]], samplers[SAMPLER_NEAREST_CLAMP]), pixel, 0);
}

// Difference of world positions across `pixel` along `axis`, taken towards
// the neighbor nearer in depth so a silhouette doesn't bend it.
vec3 surfaceStep(View camera, ivec2 pixel, ivec2 axis, vec3 fragPos, float depth) {
    ivec2 hi = min(pixel + axis, ivec2(camera.extent) - 1);
    ivec2 lo = max(pixel - axis, ivec2(0));
    float hiDepth = sceneDepth(camera, hi);
    float loDepth = sceneDepth(camera, lo);
    if (lo == pixel || (hi != pixel && abs(hiDepth - depth) <= abs(loDepth - depth))) {
        return worldPosition(camera, (vec2(hi) + 0.5) / camera.extent, hiDepth) - fragPos;
    }
    return fragPos - worldPosition(camera, (vec2(lo) + 0.5) / camera.extent, loDepth);
}

// Normal of the rasterized surface at `pixel`, rebuilt from the depth buffer
// and facing the camera: unlike the G-buffer normal, neither normal maps nor
// smooth shading tilt it off the surface the shadow map recorded. `fallback`
// where the surface is degenerate.
vec3 geometricNormal(View camera, ivec2 pixel, vec3 fragPos, float depth, vec3 fallback) {
    vec3 c = cross(surfaceStep(camera, pixel, ivec2(1, 0), fragPos, depth),
                   surfaceStep(camera, pixel, ivec2(0, 1), fragPos, depth));
    float len = length(c);
    if (len < 1e-12) return fallback;
    vec3 n = c / len;
    return dot(n, camera.position.xyz - fragPos) < 0.0 ? -n : n;
}

// Where a placed light sits and shines: its node's translation and normalized forward (+Z)
// axis, as scene.odin light_pose.
vec3 lightPosition(LightPlacement p) {
    return nodes[p.node].world_matrix[3].xyz;
}

vec3 lightForward(LightPlacement p) {
    vec3 forward = nodes[p.node].world_matrix[2].xyz;
    return dot(forward, forward) > 1e-6 ? normalize(forward) : vec3(0.0, -1.0, 0.0);
}

// Direction from the fragment towards the light.
vec3 lightDirection(LightPlacement p, vec3 fragPos) {
    if (lights[p.light].type == LIGHT_DIRECTIONAL) return -lightForward(p);
    return normalize(lightPosition(p) - fragPos);
}

// Light reaching a fragment: 1 when lit, SHADOW_FLOOR when fully occluded.
const float SHADOW_FLOOR = 0.1;
// Shadow texels from a lookup to the farthest texel its filter reads: a 3x3
// grid of 2x2 compare taps.
const float SHADOW_FILTER_RADIUS = 2.0;
// Cascades of a directional light's map, SHADOW_CASCADES in scene.odin.
const uint SHADOW_CASCADES = 4u;

// Texels on a side of a shadow map.
float shadowMapSize() {
    return float(textureSize(sampler2DArrayShadow(shadow_maps, samplers[SAMPLER_SHADOW_COMPARE]), 0).x);
}

// The shadow face seen from the light towards p: the cube face on the major
// axis of the light-to-p direction (+X, -X, +Y, -Y, +Z, -Z) for a point light,
// the finest cascade whose box holds p, with room for the filter, for a directional
// light (NO_FACE beyond the last), the only face otherwise.
uint shadowFace(LightPlacement placed, vec3 p) {
    uint type = lights[placed.light].type;
    if (type == LIGHT_DIRECTIONAL) {
        // the normal offset moves p up to SHADOW_FILTER_RADIUS + 0.5 texels
        float edge = 1.0 - 2.0 * (2.0 * SHADOW_FILTER_RADIUS + 0.5) / shadowMapSize();
        for (uint c = 0u; c < SHADOW_CASCADES; c++) {
            vec4 s = views[placed.shadow_map + c].view_projection * vec4(p, 1.0);
            // a cascade's box is no deeper than wide: with the light along
            // the view, far points project into the near cascades too
            if (abs(s.x) < edge && abs(s.y) < edge && s.z > 0.0 && s.z < 1.0) return c;
        }
        return NO_FACE;
    }
    if (type != LIGHT_POINT) return 0u;
    vec3 d = p - lightPosition(placed);
    vec3 a = abs(d);
    if (a.x >= a.y && a.x >= a.z) return d.x >= 0.0 ? 0u : 1u;
    if (a.y >= a.z) return d.y >= 0.0 ? 2u : 3u;
    return d.z >= 0.0 ? 4u : 5u;
}

// World size of a shadow texel of `view` at fragPos: constant for an
// orthographic map, read from its projection, growing with view depth for a
// perspective one (a point light's cube faces span 90 degrees, a spot light's map its cone).
float shadowTexel(LightPlacement placed, vec3 fragPos, View view) {
    Light light = lights[placed.light];
    vec3 d = fragPos - lightPosition(placed);
    if (light.type == LIGHT_POINT) {
        vec3 a = abs(d);
        return 2.0 * tan(0.25 * PI) / shadowMapSize() * max(a.x, max(a.y, a.z));
    }
    if (light.type == LIGHT_SPOT) {
        float per_depth = 2.0 * tan(0.5 * max(light.angle_outer * 2.0, 0.001)) / shadowMapSize();
        return per_depth * max(dot(d, lightForward(placed)), 0.0);
    }
    return 2.0 / (view.projection[0][0] * shadowMapSize());
}

// Depth test of fragPos against its shadow face, filtered over a 3x3 grid of
// 2x2 compare taps. The lookup moves off the surface along its geometric
// normal n, further the more the surface turns from the light direction L,
// so the filter's texels all lie in front of it. The face's view projects it
// into its atlas layer, rendered with an unflipped viewport (clip y = -1 is
// texel row 0).
float calculateShadow(LightPlacement placed, vec3 fragPos, vec3 n, vec3 L) {
    if (placed.shadow_map == 0u) return 1.0; // no shadow map
    uint type = lights[placed.light].type;
    float cosTheta = clamp(dot(n, L), 0.0, 1.0);
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    float offset = 0.5 + SHADOW_FILTER_RADIUS * sinTheta;
    vec3 p = fragPos;
    uint face;
    if (type == LIGHT_DIRECTIONAL) {
        // the cascade sets the texel size, so pick it before the offset
        face = shadowFace(placed, p);
        if (face == NO_FACE) return 1.0;
        p += n * (offset * shadowTexel(placed, p, views[placed.shadow_map + face]));
    } else {
        // the texel size doesn't depend on the face; the offset may cross one
        p += n * (offset * shadowTexel(placed, p, views[placed.shadow_map]));
        face = shadowFace(placed, p);
    }
    View view = views[placed.shadow_map + face];
    vec4 lightSpacePos = view.view_projection * vec4(p, 1.0);
    vec3 shadowCoord = lightSpacePos.xyz / lightSpacePos.w;
    shadowCoord.xy = shadowCoord.xy * 0.5 + 0.5;
    if (shadowCoord.x < 0.0 || shadowCoord.x > 1.0 ||
        shadowCoord.y < 0.0 || shadowCoord.y > 1.0) {
        return 1.0;
    }
    shadowCoord.z = clamp(shadowCoord.z, 0.0, 1.0);
    vec2 texel = vec2(1.0 / shadowMapSize());
    float lit = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 uv = shadowCoord.xy + vec2(x, y) * texel;
            // no implicit derivatives in compute: zero gradients sample mip 0
            lit += textureGrad(sampler2DArrayShadow(shadow_maps, samplers[SAMPLER_SHADOW_COMPARE]), vec4(uv, float(view.layer), shadowCoord.z), vec2(0.0), vec2(0.0));
        }
    }
    return mix(SHADOW_FLOOR, 1.0, lit / 9.0);
}

// Inverse-square falloff windowed to reach zero, with zero slope, at radius.
float distanceFalloff(float dist, float radius) {
    float r = dist / max(radius, 0.01);
    float window = clamp(1.0 - r * r * r * r, 0.0, 1.0);
    return window * window / (dist * dist + 1.0);
}

float attenuation(LightPlacement placed, vec3 fragPos) {
    Light light = lights[placed.light];
    if (light.type == LIGHT_DIRECTIONAL) return 1.0;
    vec3 toFrag = fragPos - lightPosition(placed);
    float dist = length(toFrag);
    float falloff = distanceFalloff(dist, light.radius);
    if (light.type == LIGHT_POINT) return falloff;
    float cosAngle = dot(toFrag / max(dist, 0.0001), lightForward(placed));
    return falloff * smoothstep(cos(light.angle_outer), cos(light.angle_inner), cosAngle);
}

// The surface a pixel shows, as the lights read it.
struct Surface {
    vec3 position;
    vec3 normal; // shading normal, from the G-buffer
    vec3 geometric; // geometricNormal, for the shadow lookup
    vec3 V;
    vec3 albedo;
    float metallic;
    float roughness;
};

// Cook-Torrance BRDF of one light, shadowed.
vec3 directLight(LightPlacement placed, Surface s) {
    Light light = lights[placed.light];
    vec3 L = lightDirection(placed, s.position);
    // facing away or out of reach, the BRDF is zero: skip the shadow lookup
    if (dot(s.normal, L) <= 0.0) return vec3(0.0);
    float atten = attenuation(placed, s.position);
    if (atten <= 0.0) return vec3(0.0);
    vec3 F0 = mix(vec3(0.04), s.albedo, s.metallic);
    vec3 light_col = light.color * light.intensity;
    vec3 H = normalize(s.V + L);
    float NdotL = max(dot(s.normal, L), 0.0);
    float NdotV = max(dot(s.normal, s.V), 0.01);
    float NdotH = max(dot(s.normal, H), 0.0);
    float alpha = s.roughness * s.roughness;
    float alpha2 = alpha * alpha;
    float denom = max(NdotH * NdotH * (alpha2 - 1.0) + 1.0, 0.001);
    float NDF = alpha2 / (PI * denom * denom);
    float k = pow(s.roughness + 1.0, 2.0) / 8.0;
    float G = NdotL / (NdotL * (1.0 - k) + k);
    G *= NdotV / (NdotV * (1.0 - k) + k);
    vec3 F = F0 + (1.0 - F0) * pow(1.0 - max(dot(H, s.V), 0.0), 5.0);
    vec3 spec = NDF * G * F / (4.0 * NdotV * NdotL + 0.01);
    vec3 kS = clamp(F, 0.0, 1.0);
    vec3 kD = (vec3(1.0) - kS) * (1.0 - s.metallic);
    vec3 direct = (kD * s.albedo / PI + spec) * light_col * NdotL * atten;
    return direct * calculateShadow(placed, s.position, s.geometric, L);
}

float prefilterMaxLod() {
    return float(textureQueryLevels(samplerCube(cube_textures[prefilter_index], samplers[SAMPLER_LINEAR_CLAMP])) - 1);
}

vec3 fresnelSchlickRoughness(float cos_theta, vec3 F0, float roughness) {
    return F0 + (max(vec3(1.0 - roughness), F0) - F0)
        * pow(clamp(1.0 - cos_theta, 0.0, 1.0), 5.0);
}

vec2 dirToEquirectUv(vec3 dir) {
    float u = atan(dir.z, dir.x) / (2.0 * PI) + 0.5;
    float v = acos(clamp(dir.y, -1.0, 1.0)) / PI;
    return vec2(u, v);
}

vec3 sampleSkybox(View camera, vec2 uv) {
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 world_far = camera.inv_view_projection * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(world_far.xyz / world_far.w - camera.position.xyz);
    float b = clamp(skybox_blur, 0.0, 1.0);
    if (b <= 0.0 || prefilter_index == INVALID_TEXTURE) {
        vec2 eq_uv = dirToEquirectUv(dir);
        return textureLod(sampler2D(textures[environment_index], samplers[SAMPLER_LINEAR_REPEAT]), eq_uv, 0.0).rgb;
    }
    float cube_lod = b * prefilterMaxLod();
    return textureLod(samplerCube(cube_textures[prefilter_index], samplers[SAMPLER_LINEAR_CLAMP]), dir, cube_lod).rgb;
}

// Image-based lighting at intensity ibl_intensity, from the unnormalized G-buffer normal.
vec3 ambientLight(float ibl_intensity, vec3 normal, Surface s, float roughness) {
    if (ibl_intensity <= 0.0 || prefilter_index == INVALID_TEXTURE) return vec3(0.0);
    vec3 R = reflect(-s.V, normal);
    float NdotV = max(dot(normal, s.V), 0.0);
    vec3 F0 = mix(vec3(0.04), s.albedo, s.metallic);
    vec3 F = fresnelSchlickRoughness(NdotV, F0, roughness);
    vec3 irradiance = textureLod(samplerCube(cube_textures[irradiance_index], samplers[SAMPLER_LINEAR_CLAMP]), normal, 0.0).rgb;
    vec3 kD = (vec3(1.0) - F) * (1.0 - s.metallic);
    vec3 prefiltered = textureLod(samplerCube(cube_textures[prefilter_index], samplers[SAMPLER_LINEAR_CLAMP]), R, roughness * prefilterMaxLod()).rgb;
    vec2 brdf = textureLod(sampler2D(textures[brdf_lut_index], samplers[SAMPLER_LINEAR_CLAMP]), vec2(NdotV, roughness), 0.0).rg;
    vec3 specular = prefiltered * (F * brdf.x + brdf.y);
    return (kD * irradiance * s.albedo + specular) * ibl_intensity;
}

// Whether the sphere (center, radius) meets the box [lo, hi].
bool sphereMeetsBox(vec3 center, float radius, vec3 lo, vec3 hi) {
    vec3 d = clamp(center, lo, hi) - center;
    return dot(d, d) <= radius * radius;
}

void main() {
    View camera = views[camera_index];
    ivec2 extent = ivec2(camera.extent);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool inside = pixel.x < extent.x && pixel.y < extent.y;

    // the tile's depth range, over the pixels that show a surface
    if (gl_LocalInvocationIndex == 0u) {
        tile_min_bits = floatBitsToUint(1.0);
        tile_max_bits = 0u;
        tile_light_count = 0u;
    }
    barrier();
    float depth = inside ? sceneDepth(camera, pixel) : 1.0;
    // depth is positive: its bits order as it does
    if (depth < 1.0) {
        atomicMin(tile_min_bits, floatBitsToUint(depth));
        atomicMax(tile_max_bits, floatBitsToUint(depth));
    }
    barrier();

    // the visible placed lights reaching the tile: directional ones, and point and spot ones
    // whose sphere meets the tile's box
    float depth_min = uintBitsToFloat(tile_min_bits);
    float depth_max = uintBitsToFloat(tile_max_bits);
    if (depth_min <= depth_max) {
        vec2 tile_lo = vec2(gl_WorkGroupID.xy * TILE) / camera.extent;
        vec2 tile_hi = vec2(min(ivec2((gl_WorkGroupID.xy + 1u) * TILE), extent)) / camera.extent;
        vec3 lo = vec3(1e30);
        vec3 hi = vec3(-1e30);
        for (uint c = 0u; c < 8u; c++) {
            vec2 uv = vec2((c & 1u) != 0u ? tile_hi.x : tile_lo.x, (c & 2u) != 0u ? tile_hi.y : tile_lo.y);
            vec3 p = worldPosition(camera, uv, (c & 4u) != 0u ? depth_max : depth_min);
            lo = min(lo, p);
            hi = max(hi, p);
        }
        for (uint i = gl_LocalInvocationIndex; i < light_count; i += TILE * TILE) {
            LightPlacement p = placements[i];
            if (p.light == 0u || (nodes[p.node].flags & NODE_VISIBLE) == 0u) continue;
            Light light = lights[p.light];
            if (light.type == LIGHT_DIRECTIONAL || sphereMeetsBox(lightPosition(p), light.radius, lo, hi)) {
                tile_lights[atomicAdd(tile_light_count, 1u)] = i;
            }
        }
    }
    barrier();
    if (!inside) return;

    vec2 uv = (vec2(pixel) + 0.5) / camera.extent;
    // background (depth left at the far clear value): the skybox, if any
    if (depth >= 1.0) {
        vec3 sky = vec3(0.0);
        if (skybox_intensity > 0.0 && environment_index != INVALID_TEXTURE) sky = sampleSkybox(camera, uv) * skybox_intensity;
        imageStore(lit_images[output_index], pixel, vec4(sky, 1.0));
        return;
    }
    vec3 raw_normal = camera_image(camera, IMAGE_NORMAL, pixel).xyz * 2.0 - 1.0;
    vec2 mr = camera_image(camera, IMAGE_METALLIC_ROUGHNESS, pixel).rg;
    Surface s;
    s.position = worldPosition(camera, uv, depth);
    // unfiltered: a blend across a silhouette is no surface's normal
    s.normal = normalize(raw_normal);
    s.V = normalize(camera.position.xyz - s.position);
    s.albedo = camera_image(camera, IMAGE_ALBEDO, pixel).rgb;
    s.metallic = clamp(mr.r, 0.0, 1.0);
    s.geometric = geometricNormal(camera, pixel, s.position, depth, s.normal);

    vec3 color = camera_image(camera, IMAGE_EMISSIVE, pixel).rgb;
    color += ambientLight(ibl_intensity, raw_normal, s, mr.g);
    s.roughness = clamp(mr.g, 0.08, 1.0);
    for (uint i = 0u; i < tile_light_count; i++) {
        color += directLight(placements[tile_lights[i]], s);
    }
    imageStore(lit_images[output_index], pixel, vec4(color, 1.0));
}
