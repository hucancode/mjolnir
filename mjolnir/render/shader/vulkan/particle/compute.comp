#version 450

const int MAX_PARTICLES = 65536;
const int MAX_FORCE_FIELDS = 32;

struct Particle {
    vec3 position;
    float size_start;
    vec3 velocity;
    float size_end;
    vec4 color_start;
    vec4 color_end;
    float life;
    float max_life;
    float weight;
    uint texture_index;
};

struct ForceField {
    float tangent_strength;
    float strength;
    float area_of_effect;
};

struct ForceFieldPlacement {
    uint forcefield;
    uint node;
};

layout(set = 0, binding = 8) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform ParticleSystemParams {
    uint emitter_placement_count;
    uint forcefield_placement_count;
    float delta_time;
    uint frame_counter;
    uint emit_total;
    uint emit_cursor;
};

// Indirect draw of the live particles, then their indices.
layout(set = 0, binding = 9) buffer AliveBuffer {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
    uint alive[];
};

layout(set = 0, binding = 7) readonly buffer ForceFieldBuffer {
    ForceField forcefields[];
};

layout(set = 0, binding = 20) readonly buffer ForceFieldPlacementBuffer {
    ForceFieldPlacement placements[];
};

struct Node {
    mat4 world_matrix;
    uint material_id;
    uint mesh_id;
    uint attachment_data_index;
    uint flags;
    uint skin_vertex_base; // first of the skinned vertices when skinned
    uint _node_pad[3];
};

layout(set = 0, binding = 1) readonly buffer NodeDataBuffer {
    Node nodes[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const vec3 GRAVITY = vec3(0.0, -9.8, 0.0);

// Advance live particle i; returns whether it is still alive.
bool simulate(uint i) {
    vec3 p = particles[i].position;
    vec3 v = particles[i].velocity;
    uint n = min(forcefield_placement_count, MAX_FORCE_FIELDS);
    for (uint f = 0; f < n; ++f) {
        ForceFieldPlacement placed = placements[f];
        // free rows and destroyed force fields are zero: area_of_effect 0
        ForceField ff = forcefields[placed.forcefield];
        if (ff.area_of_effect <= 0.0 || placed.node == 0u) continue;
        vec3 ff_pos = nodes[placed.node].world_matrix[3].xyz;
        vec3 to_particle = p - ff_pos;
        float dist = length(to_particle);
        if (dist > ff.area_of_effect) continue;
        float effect = 1.0 - clamp(dist / ff.area_of_effect, 0.0, 1.0);
        float safe_dist = max(dist, 1e-4);
        vec3 dir = (ff_pos - p) / safe_dist;
        vec3 ref = mix(vec3(0, 1, 0), vec3(1, 0, 0), step(0.99, abs(dir.y)));
        vec3 tangent = normalize(cross(ref, dir));
        vec3 force = dir * ff.strength + tangent * ff.tangent_strength;
        v += force * effect * delta_time;
    }
    v += GRAVITY * particles[i].weight * delta_time;
    // Limit speed (branchless div-by-zero guard)
    float speed = length(v);
    v *= min(speed, 5.0) / max(speed, 1e-6);
    particles[i].velocity = v;
    particles[i].position = p + v * delta_time;
    float life = particles[i].life - delta_time;
    particles[i].life = life;
    return life > 0.0;
}

// Live particles of this group, appended to the alive list with one global
// atomic per group.
shared uint group_alive;
shared uint group_first;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationIndex == 0u) group_alive = 0u;
    barrier();
    bool live = i < MAX_PARTICLES && particles[i].life > 0.0;
    uint slot = 0u;
    if (live) {
        live = simulate(i);
        if (live) slot = atomicAdd(group_alive, 1u);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) group_first = atomicAdd(vertex_count, group_alive);
    barrier();
    if (live) alive[group_first + slot] = i;
}
