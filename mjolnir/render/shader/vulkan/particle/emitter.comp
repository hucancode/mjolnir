#version 450

const int MAX_PARTICLES = 65536;
const int MAX_EMITTERS = 64;

struct Particle {
    vec3 position;
    float size_start;
    vec3 velocity;
    float size_end;
    vec4 color_start;
    vec4 color_end;
    float life;
    float max_life;
    float weight;
    uint texture_index;
};

struct Emitter {
  vec3 initial_velocity;
  float velocity_spread;
  vec4 color_start;
  vec4 color_end;
  float position_spread;
  float size_start;
  float size_end;
  float particle_lifetime;
  float weight;
  float weight_spread;
  float emission_rate; // read by render, which counts each frame's new particles
  uint texture_index;
};

// Where an emitter is attached; placement i emits the frame's new particles
// [emit_first, the next placement's emit_first).
struct EmitterPlacement {
  uint emitter;
  uint node;
  uint emit_first;
};

layout(set = 0, binding = 6) readonly buffer EmitterBuffer {
    Emitter emitters[];
};

layout(set = 0, binding = 19) readonly buffer EmitterPlacementBuffer {
    EmitterPlacement placements[];
};

layout(set = 0, binding = 8) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform ParticleSystemParams {
    uint emitter_placement_count;
    uint forcefield_placement_count;
    float delta_time;
    uint frame_counter;
    uint emit_total; // new particles this frame
    uint emit_cursor; // ring slot of the first one
};

struct Node {
    mat4 world_matrix;
    uint material_id;
    uint mesh_id;
    uint attachment_data_index;
    uint flags;
    uint skin_vertex_base; // first of the skinned vertices when skinned
    uint _node_pad[3];
};

layout(set = 0, binding = 1) readonly buffer WorldMatrixBuffer {
    Node nodes[];
};

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// PCG hash: gives independent, well-distributed 32-bit outputs even when
// inputs differ by 1, so spawn positions do not cluster when the emitter
// index dominates the seed.
uint pcg_hash(uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand_unit(uint seed) {
    return float(pcg_hash(seed)) * (1.0 / 4294967296.0);
}

// Generates a random vector within a sphere of given radius. Each component
// is driven by an independent hash of seed/seed+1/seed+2 so x/y/z aren't
// correlated.
vec3 random_in_sphere(float radius, uint seed) {
    float u = rand_unit(seed);
    float v = rand_unit(seed + 1u);
    float w = rand_unit(seed + 2u);
    float theta = u * 6.28318530718;
    float cos_phi = 2.0 * v - 1.0;
    float sin_phi = sqrt(max(0.0, 1.0 - cos_phi * cos_phi));
    float r = pow(w, 1.0 / 3.0) * radius;
    return vec3(
        r * sin_phi * cos(theta),
        r * sin_phi * sin(theta),
        r * cos_phi
    );
}

// The placement whose range [emit_first, next placement's emit_first) holds new
// particle `id`: the last placement with emit_first <= id. Placements with no new
// particles share their successor's emit_first and are never picked.
uint find_placement(uint id) {
    uint lo = 0u;
    uint hi = emitter_placement_count;
    while (lo < hi) {
        uint mid = (lo + hi) / 2u;
        if (placements[mid].emit_first <= id) lo = mid + 1u;
        else hi = mid;
    }
    return lo - 1u;
}

// One thread per new particle, written to the ring slot after the previous
// one; once the ring is full new particles overwrite the oldest.
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= emit_total) return;
    uint placement_idx = find_placement(id);
    EmitterPlacement placed = placements[placement_idx];
    Emitter emitter = emitters[placed.emitter];
    uint idx = (emit_cursor + id) % uint(MAX_PARTICLES);
    // Varies across frames, placements and particles: without frame_counter
    // low-rate emitters would spawn at the same point every frame.
    uint seed = pcg_hash(idx
                         ^ (frame_counter * 2654435761u)
                         ^ (placement_idx * 374761393u)
                         ^ ((id - placed.emit_first) * 2246822519u));
    mat4 world = nodes[placed.node].world_matrix;
    mat3 world_rotation = mat3(world);
    // Position: emitter position + random spread (local spread rotated into world space)
    vec3 pos_spread = random_in_sphere(emitter.position_spread, seed);
    vec3 position = world[3].xyz + world_rotation * pos_spread;
    // Velocity: initial_velocity + random spread (expressed in local space)
    vec3 vel_spread = random_in_sphere(emitter.velocity_spread, seed + 7u);
    vec3 velocity = world_rotation * (emitter.initial_velocity + vel_spread);
    float lifetime = emitter.particle_lifetime;
    float weight = emitter.weight + (rand_unit(seed + 13u) - 0.5) * emitter.weight_spread;
    particles[idx] = Particle(
        position,
        emitter.size_start,
        velocity,
        emitter.size_end,
        emitter.color_start,
        emitter.color_end,
        lifetime,
        lifetime,
        weight,
        emitter.texture_index
    );
}
