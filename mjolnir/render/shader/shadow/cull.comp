#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint NODE_FLAG_CULLING_ENABLED = 1u << 1;
const uint INVALID_ID = 0xFFFFFFFFu;

struct NodeData {
    mat4 world_matrix;
    uint material_id;
    uint mesh_id;
    uint attachment_data_index;
    uint flags;
};

struct MeshData {
    vec3 aabb_min;
    uint index_count;
    vec3 aabb_max;
    uint first_index;
    int vertex_offset;
    uint vertex_skinning_offset;
    uint flags;
    uint _padding;
};

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

struct ShadowView {
    vec4 planes[6]; // normalized, pointing inward
};

layout(push_constant) uniform PushConstants {
    uint node_count;
    uint view_count;
    uint max_draws; // per view
    uint include_flags;
    uint exclude_flags;
} params;

layout(set = 0, binding = 0) readonly buffer NodeBuffer {
    NodeData nodes[];
};

layout(set = 0, binding = 1) readonly buffer MeshBuffer {
    MeshData meshes[];
};

layout(set = 0, binding = 2) readonly buffer ViewBuffer {
    ShadowView views[];
};

// One count per view.
layout(set = 0, binding = 3) buffer DrawCountBuffer {
    uint draw_counts[];
};

// View v's list starts at v * max_draws.
layout(set = 0, binding = 4) buffer DrawCommandBuffer {
    DrawCommand commands[];
};

bool in_view(uint v, vec3 center, vec3 extent) {
    for (int i = 0; i < 6; ++i) {
        vec4 plane = views[v].planes[i];
        float distance = dot(plane.xyz, center) + plane.w;
        float radius = dot(abs(plane.xyz), extent);
        if (distance + radius < 0.0) {
            return false;
        }
    }
    return true;
}

// One thread per node: test it against every view and append it to the
// list of each view it touches.
void main() {
    uint node_id = gl_GlobalInvocationID.x;
    if (node_id >= params.node_count) return;

    NodeData node = nodes[node_id];
    if (node.mesh_id == INVALID_ID) {
        return;
    }

    if ((node.flags & params.include_flags) != params.include_flags) {
        return;
    }
    if ((node.flags & params.exclude_flags) != 0u) {
        return;
    }

    MeshData mesh = meshes[node.mesh_id];
    mat4 world = node.world_matrix;

    vec3 local_min = mesh.aabb_min;
    vec3 local_max = mesh.aabb_max;
    vec3 local_center = 0.5 * (local_min + local_max);
    vec3 local_extent = 0.5 * (local_max - local_min);
    vec4 world_center4 = world * vec4(local_center, 1.0);
    vec3 world_center = world_center4.xyz / max(world_center4.w, 1e-6);
    mat3 world3 = mat3(world);
    mat3 abs_world3 = mat3(abs(world3[0]), abs(world3[1]), abs(world3[2]));
    vec3 world_extent = abs_world3 * local_extent;
    bool culling = (node.flags & NODE_FLAG_CULLING_ENABLED) != 0u;

    DrawCommand cmd;
    cmd.index_count = mesh.index_count;
    cmd.instance_count = 1u;
    cmd.first_index = mesh.first_index;
    cmd.vertex_offset = mesh.vertex_offset;
    cmd.first_instance = node_id;

    for (uint v = 0u; v < params.view_count; ++v) {
        if (culling && !in_view(v, world_center, world_extent)) continue;
        uint draw_index = atomicAdd(draw_counts[v], 1u);
        if (draw_index < params.max_draws) {
            commands[v * params.max_draws + draw_index] = cmd;
        }
    }
}
