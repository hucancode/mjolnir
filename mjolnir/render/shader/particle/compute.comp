#version 450

const int MAX_PARTICLES = 65536;
const int MAX_FORCE_FIELDS = 32;

struct Particle {
    vec3 position;
    float size_start;
    vec3 velocity;
    float size_end;
    vec4 color_start;
    vec4 color_end;
    float life;
    float max_life;
    float weight;
    uint texture_index;
};

struct ForceField {
    float tangent_strength;
    float strength;
    float area_of_effect;
    uint node_index;
};

layout(set = 0, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(set = 0, binding = 2) uniform ParamsBuffer {
    uint emitter_count;
    uint forcefield_count;
    float delta_time;
    uint frame_counter;
};

layout(set = 1, binding = 0) readonly buffer ForceFieldBuffer {
    ForceField forcefields[];
};

struct NodeData {
    mat4 world_matrix;
    uint material_id;
    uint mesh_id;
    uint attachment_data_index;
    uint flags;
};

layout(set = 2, binding = 0) readonly buffer NodeDataBuffer {
    NodeData nodes[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const vec3 GRAVITY = vec3(0.0, -9.8, 0.0);

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= MAX_PARTICLES || particles[i].life <= 0.0) return;
    vec3 p = particles[i].position;
    vec3 v = particles[i].velocity;
    uint n = min(forcefield_count, MAX_FORCE_FIELDS);
    for (uint f = 0; f < n; ++f) {
        ForceField ff = forcefields[f];
        // Unused slots have area_of_effect 0
        if (ff.area_of_effect <= 0.0) continue;
        vec3 ff_pos = nodes[ff.node_index].world_matrix[3].xyz;
        vec3 to_particle = p - ff_pos;
        float dist = length(to_particle);
        if (dist > ff.area_of_effect) continue;
        float effect = 1.0 - clamp(dist / ff.area_of_effect, 0.0, 1.0);
        float safe_dist = max(dist, 1e-4);
        vec3 dir = (ff_pos - p) / safe_dist;
        vec3 ref = mix(vec3(0, 1, 0), vec3(1, 0, 0), step(0.99, abs(dir.y)));
        vec3 tangent = normalize(cross(ref, dir));
        vec3 force = dir * ff.strength + tangent * ff.tangent_strength;
        v += force * effect * delta_time;
    }
    v += GRAVITY * particles[i].weight * delta_time;
    // Limit speed (branchless div-by-zero guard)
    float speed = length(v);
    v *= min(speed, 5.0) / max(speed, 1e-6);
    particles[i].velocity = v;
    particles[i].position = p + v * delta_time;
    particles[i].life -= delta_time;
}
