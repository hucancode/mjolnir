#version 450
// Steers each fish by its neighbours (separation, alignment, cohesion), the food and the shark,
// reading one half of the fish buffer and writing the other, and counts what it moved into the
// indirect draw and the stats.

struct Params {
    uint count;
    uint src;
    float dt;
    uint vertices;
    vec4 food;
    vec4 predator;
    vec4 weights;
    vec4 tank_min;
    vec4 tank_max;
};
#include "gpu.glsl"

layout(local_size_x = 64) in;

struct Fish {
    vec3 position;
    float phase;
    vec3 velocity;
    float size;
};

layout(set = 1, binding = 0) buffer School {
    Fish fish[];
};

layout(set = 1, binding = 1) buffer Counters {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
    uint feeding;
    uint speed_milli;
};

const uint MAX_FISH = 4096u;
const float VIEW_RADIUS = 2.5;
const float SEPARATION_RADIUS = 0.8;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i == 0u) vertex_count = gpu.params.vertices;
    if (i >= gpu.params.count) return;
    uint base = gpu.params.src * MAX_FISH;
    Fish me = fish[base + i];
    vec3 separate = vec3(0.0);
    vec3 heading = vec3(0.0);
    vec3 center = vec3(0.0);
    float neighbours = 0.0;
    for (uint j = 0u; j < gpu.params.count; j++) {
        if (j == i) continue;
        Fish other = fish[base + j];
        vec3 offset = me.position - other.position;
        float d = length(offset);
        if (d > VIEW_RADIUS) continue;
        if (d < SEPARATION_RADIUS) separate += offset / max(d * d, 0.01);
        heading += other.velocity;
        center += other.position;
        neighbours += 1.0;
    }
    vec4 w = gpu.params.weights;
    vec3 steer = separate * w.x;
    if (neighbours > 0.0) {
        steer += (heading / neighbours - me.velocity) * w.y;
        steer += (center / neighbours - me.position) * w.z;
    }
    if (gpu.params.food.w > 0.0) steer += normalize(gpu.params.food.xyz - me.position) * 3.0;
    vec3 away = me.position - gpu.params.predator.xyz;
    float danger = length(away);
    if (gpu.params.predator.w > 0.0 && danger < 4.0) steer += away / max(danger, 0.1) * (4.0 - danger) * 4.0;
    vec3 lo = gpu.params.tank_min.xyz;
    vec3 hi = gpu.params.tank_max.xyz;
    steer += (max(lo + 1.0 - me.position, 0.0) - max(me.position - hi + 1.0, 0.0)) * 4.0;

    vec3 v = me.velocity + steer * gpu.params.dt;
    float speed = clamp(length(v), w.w * 0.3, w.w);
    v = normalize(v + vec3(0.0, 0.0, 1e-4)) * speed;
    me.velocity = v;
    me.position = clamp(me.position + v * gpu.params.dt, lo, hi);
    me.phase = mod(me.phase + gpu.params.dt * (4.0 + speed * 3.0), 6.2831853);
    fish[(1u - gpu.params.src) * MAX_FISH + i] = me;

    atomicAdd(instance_count, 1u);
    atomicAdd(speed_milli, uint(speed * 1000.0));
    if (gpu.params.food.w > 0.0 && distance(me.position, gpu.params.food.xyz) < 2.5) atomicAdd(feeding, 1u);
}
